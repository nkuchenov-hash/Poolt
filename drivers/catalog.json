        "BACK": { "method": "POST", "path": "/keypress/Back" },
        "UP": { "method": "POST", "path": "/keypress/Up" },
        "DOWN": { "method": "POST", "path": "/keypress/Down" },
        "LEFT": { "method": "POST", "path": "/keypress/Left" },
        "RIGHT": { "method": "POST", "path": "/keypress/Right" },
        "OK": { "method": "POST", "path": "/keypress/Select" },
        "PLAY_PAUSE": { "method": "POST", "path": "/keypress/Play" }
      }
    }
